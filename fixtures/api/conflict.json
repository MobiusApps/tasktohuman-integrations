{
  "title": "The same key with a different body",
  "request": {
    "method": "POST",
    "path": "/v1/tasks",
    "headers": {
      "Idempotency-Key": "refund-4821"
    },
    "body": {
      "task_type": "approve_refund",
      "title": "Refund €250 to order #4821?",
      "payload": {
        "order_id": "4821",
        "amount": 250,
        "reason": "Arrived damaged",
        "customer_email": "marta@example.com"
      },
      "deadline_minutes": 120
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "body": {
      "type": "https://tools.ietf.org/html/rfc9110#section-15.5.10",
      "title": "This idempotency key was already used with a different request.",
      "status": 409,
      "code": "idempotency_conflict",
      "traceId": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
    }
  }
}
