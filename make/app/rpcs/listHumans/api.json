{
  "url": "/v1/humans",
  "method": "GET",
  "qs": {
    "limit": 100
  },
  "response": {
    "iterate": "{{body.data}}",
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    },
    "limit": 500
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.next_cursor}}"
    },
    "condition": "{{body.next_cursor}}"
  }
}
